# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y rellena los valores.
# Todo es opcional para que la web funcione: sin nada configurado
# la landing sigue online, pero no se guardan leads ni hay panel.
# ─────────────────────────────────────────────────────────────

# Tu número de WhatsApp con prefijo internacional, sin + ni espacios.
# Ejemplo: 34600111222
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública de tu web (la usas para enlaces y para el PDF de la propuesta)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Enlace de pago de Stripe (Payment Link) para la auditoría de 199 €.
# Créalo en Stripe > Payment Links > precio 199 EUR.
NEXT_PUBLIC_STRIPE_AUDIT_URL=

# ─── Supabase (panel + base de datos de clientes) ───
# Crear el proyecto en supabase.com, ejecutar supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. NUNCA lo expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ─── WhatsApp Business Cloud API (motor) ───
# Credenciales POR CLIENTE: normalmente las guardas en el panel
# (pestaña "Motor WhatsApp"), no aquí. Estas dos variables son
# el respaldo para trabajar con tu propia cuenta / pruebas.
# Phone Number ID (no es el número, es el ID del número en la API)
WHATSAPP_PHONE_NUMBER_ID=
# Token de acceso permanente de WhatsApp Business
WHATSAPP_TOKEN=

# ─── Campañas automáticas ───
# Clave que protege la ruta /api/whatsapp/cron (Vercel Cron o n8n).
# Si no la defines, la ruta se rechaza.
CRON_SECRET=
