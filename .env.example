# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y rellena los valores.
# Todo es opcional para que la web funcione: sin nada configurado
# la landing sigue online, pero no se guardan leads ni hay panel.
# ─────────────────────────────────────────────────────────────

# Tu número de WhatsApp con prefijo international, sin + ni espacios.
# Ejemplo: 34600111222
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública de tu web (la usas para enlaces y para el PDF de la propuesta)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Enlace de pago de Stripe (Payment Link) para el diagnóstico de 149 €.
# Créalo en Stripe > Payment Links > precio 149 EUR.
NEXT_PUBLIC_STRIPE_AUDIT_URL=

# ─── Supabase (panel + base de datos de clientes) ───
# Crear el proyecto en supabase.com, ejecutar supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. NUNCA lo expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
